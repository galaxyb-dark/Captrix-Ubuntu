[Desktop Entry]
Version=1.0
Type=Application
Name=Captrix
GenericName=Caption catcher
Comment=Catch Google Live Caption text into a panel you can copy
Exec=@ROOT@/bin/captrix
Path=@ROOT@
Icon=@ROOT@/data/icons/com.captrix.Captrix.svg
Terminal=false
Categories=Utility;Accessibility;
Keywords=caption;subtitles;transcript;chrome;
StartupNotify=true
StartupWMClass=com.captrix.Captrix
